# Supabase Database Connection
# 从 Supabase Dashboard > Settings > Database > Connection string 获取

# 应用运行时使用连接池（端口 6543）- 推荐用于生产环境
DATABASE_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 数据库迁移使用直接连接（端口 5432）
DIRECT_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"

# JWT Secret - 用于生成和验证 JWT token
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Port
PORT=3001

# Gemini API Key (可选 - 用于 AI 功能)
GEMINI_API_KEY="your-gemini-api-key-here"

# Qwen API Key (可选 - 用于 AI 功能)
QWEN_API_KEY="your-qwen-api-key-here"
